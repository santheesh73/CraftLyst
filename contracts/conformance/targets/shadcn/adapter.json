{
  "name": "shadcn-ui",
  "library": {
    "name": "shadcn/ui (new-york-v4 registry, generated with the shadcn CLI)",
    "version": "shadcn-ui/ui@4233ed1caded8c38f4bc14b14afe1f93ebcaf966",
    "packages": {
      "shadcn (CLI)": "4.21.5",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "radix-ui": "1.8.1",
      "sonner": "2.0.8",
      "next-themes": "0.4.6",
      "class-variance-authority": "0.7.1",
      "cn": "0.4.0",
      "lucide-react": "1.57.0",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0"
    }
  },
  "trust": "external library under test (demo page written for this kit)",
  "notes": "Build first: see ../README.md. Component source is generated outside this repository and mapped with build.js --src.",
  "page": { "file": "index.html", "ready": "#demo" },
  "components": {
    "button": { "button": "#sh-save", "toggle": "#sh-bold", "disabled": "#sh-off", "region": "#c-button" },
    "text-field": { "input": "#sh-email", "required": true, "invalidValue": "not-an-email", "submit": "#sh-email-submit", "region": "#c-text-field" },
    "select-combobox": { "trigger": "#sh-select", "region": "#c-select" },
    "dialog": { "trigger": "#sh-dialog-open" },
    "menu": { "trigger": "#sh-menu-btn", "region": "#c-menu" },
    "tabs": { "tablist": "#sh-tabs", "region": "#c-tabs" },
    "tooltip-popover": { "tooltipTrigger": "#sh-tip-btn", "popoverTrigger": "#sh-pop-btn", "region": "#c-tooltip" },
    "accordion-disclosure": { "triggers": "#c-accordion .acc", "region": "#c-accordion" },
    "toast-alert": { "trigger": "#sh-toast-btn", "toast": "[data-sonner-toast]", "region": "#c-toast" },
    "table": { "table": "#sh-table", "region": "#c-table" },
    "pagination": { "nav": "#sh-pagination", "region": "#c-pagination" },
    "navigation": { "nav": "#sh-nav", "submenuTrigger": "#sh-nav-more" }
  }
}
