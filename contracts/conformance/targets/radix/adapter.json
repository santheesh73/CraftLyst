{
  "name": "radix-primitives",
  "library": {
    "name": "Radix Primitives",
    "version": "see packages",
    "packages": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@radix-ui/react-accordion": "1.3.1",
      "@radix-ui/react-dialog": "1.3.1",
      "@radix-ui/react-dropdown-menu": "2.2.1",
      "@radix-ui/react-form": "0.3.0",
      "@radix-ui/react-navigation-menu": "1.4.1",
      "@radix-ui/react-popover": "1.3.1",
      "@radix-ui/react-select": "2.4.1",
      "@radix-ui/react-tabs": "1.2.1",
      "@radix-ui/react-toast": "1.3.1",
      "@radix-ui/react-toggle": "1.2.1",
      "@radix-ui/react-tooltip": "1.4.1"
    }
  },
  "trust": "external library under test (demo page written for this kit)",
  "notes": "Build first: see ../README.md. The page renders each primitive with minimal glue.",
  "page": { "file": "index.html", "ready": "#demo" },
  "components": {
    "button": { "button": "#rx-toggle", "toggle": "#rx-toggle", "disabled": "#rx-toggle-off", "region": "#c-button" },
    "text-field": { "input": "#c-text-field input[name=\"email\"]", "required": true, "invalidValue": "not-an-email", "submit": "#rx-email-submit", "region": "#c-text-field" },
    "select-combobox": { "trigger": "#rx-select", "region": "#c-select" },
    "dialog": { "trigger": "#rx-dialog-open" },
    "menu": { "trigger": "#rx-menu-btn", "region": "#c-menu" },
    "tabs": { "tablist": "#rx-tabs", "region": "#c-tabs" },
    "tooltip-popover": { "tooltipTrigger": "#rx-tip-btn", "popoverTrigger": "#rx-pop-btn", "region": "#c-tooltip" },
    "accordion-disclosure": { "triggers": "#c-accordion .acc", "region": "#c-accordion" },
    "toast-alert": { "trigger": "#rx-toast-btn", "toast": "li.toast", "region": "#c-toast" },
    "table": { "notApplicable": "Radix Primitives has no table primitive." },
    "pagination": { "notApplicable": "Radix Primitives has no pagination primitive." },
    "navigation": { "nav": "#rx-nav", "submenuTrigger": "#rx-nav-more" }
  }
}
