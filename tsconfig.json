{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["cli/bin/**/*.js", "cli/src/**/*.js", "cli/rules/**/*.js", "scripts/**/*.js", "evals/**/*.js"],
  "exclude": ["dist", "node_modules", "cli/fixtures"]
}
