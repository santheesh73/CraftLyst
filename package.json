{
  "name": "frontend-craft",
  "version": "0.1.0",
  "description": "An installable skill and CLI that gives AI coding agents a design contract, executable frontend checks, and proof reports.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "craft": "cli/bin/craft.js"
  },
  "scripts": {
    "lint": "node scripts/lint.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.js",
    "validate": "node scripts/validate-schemas.js && node scripts/validate-skill.js",
    "package": "node scripts/package.js",
    "verify-package": "node scripts/verify-package.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate",
    "coverage": "node --test --experimental-test-coverage cli/test/*.test.js",
    "triggers": "node evals/triggers/run.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "axe-core": "4.13.0",
    "playwright": "1.56.1",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "parse5": "8.0.1",
    "postcss": "8.5.28"
  }
}
