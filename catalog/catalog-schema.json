{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend-craft:schema:catalog-entry:1.0",
  "title": "Frontend Craft catalog entry card",
  "description": "Entry card. Cross-field rules (L3 requires evidence, deprecated requires a deprecation note, unverifiable facts require status draft and verified_on null) are enforced by craft catalog validate.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "category",
    "description",
    "intent",
    "source",
    "characteristics",
    "axes",
    "compatibility",
    "license",
    "trust",
    "verified_on",
    "status",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "category": {
      "enum": [
        "page-composition",
        "component",
        "motion",
        "specialized-product",
        "design-system"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "intent": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "url",
        "attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "original-spec",
            "first-party-oss",
            "official-docs",
            "gallery-reference",
            "link-only"
          ]
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string"
        }
      }
    },
    "characteristics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": {
          "$ref": "#/$defs/axisFit"
        },
        "temperature": {
          "$ref": "#/$defs/axisFit"
        },
        "formality": {
          "$ref": "#/$defs/axisFit"
        },
        "motion": {
          "$ref": "#/$defs/axisFit"
        },
        "shape": {
          "$ref": "#/$defs/axisFit"
        },
        "contrast": {
          "$ref": "#/$defs/axisFit"
        },
        "voice": {
          "$ref": "#/$defs/axisFit"
        },
        "imagery": {
          "$ref": "#/$defs/axisFit"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "frameworks",
        "styling"
      ],
      "additionalProperties": false,
      "properties": {
        "frameworks": {
          "type": "array",
          "items": {
            "enum": [
              "any",
              "react",
              "next",
              "vue",
              "svelte",
              "astro",
              "html"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "styling": {
          "type": "array",
          "items": {
            "enum": [
              "any",
              "css",
              "tailwind-v3",
              "tailwind-v4",
              "css-modules",
              "scss",
              "css-in-js"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "range"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "interaction": {
      "type": "string"
    },
    "responsive": {
      "type": "string"
    },
    "accessibility": {
      "type": "string"
    },
    "license": {
      "type": "object",
      "required": [
        "name",
        "spdx",
        "redistribution"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "spdx": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9.+-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "attribution-required",
            "link-only",
            "unknown"
          ]
        }
      }
    },
    "trust": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "verified_on": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "tested",
        "deprecated"
      ]
    },
    "deprecation": {
      "type": "object",
      "required": [
        "note",
        "replacement"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 10
        },
        "replacement": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "$defs": {
    "axisFit": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z-]+$"
      }
    }
  }
}
