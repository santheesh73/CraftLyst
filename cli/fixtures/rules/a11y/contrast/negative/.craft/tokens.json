{
  "$schema": "urn:frontend-craft:schema:tokens:1.0",
  "themes": [
    "light"
  ],
  "primitive": {
    "color": {
      "gray-400": "#aaaaaa",
      "gray-700": "#595959",
      "white": "#ffffff"
    }
  },
  "semantic": {
    "color": {
      "text": {
        "light": "{primitive.color.gray-700}"
      },
      "surface": {
        "light": "{primitive.color.white}"
      }
    }
  },
  "pairs": [
    {
      "fg": "semantic.color.text",
      "bg": "semantic.color.surface",
      "use": "text"
    }
  ]
}
